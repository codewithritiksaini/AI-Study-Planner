# =============================================================================
# AI STUDY PLANNER: FRONTEND CLIENT CONFIGURATION (.env.example)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put private API keys (GEMINI_API_KEY or SERVICE_ROLE_KEY) here!
# =============================================================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:5000/api

# Supabase Platform Public Credentials (Required for Phase 2+)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
