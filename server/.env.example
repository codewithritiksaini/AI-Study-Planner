# =============================================================================
# AI STUDY PLANNER: BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file to Git.
# =============================================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Allowed CORS Origin (Frontend SPA URL)
CLIENT_URL=http://localhost:5173

# Supabase Platform Credentials (Required for Phase 2+)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Google Gemini API Key & Model (Required for Phase 6+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
